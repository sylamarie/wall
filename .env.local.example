# Copy this file to ".env.local" (same folder) and fill in the two values.
# You find them in your Supabase dashboard under Project Settings > API
# (or "API Keys"). Use the Project URL and the "anon" / "publishable" key.
# NEVER use the "service_role" or "secret" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
